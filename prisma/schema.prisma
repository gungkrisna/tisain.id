generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
  relationMode = "prisma"
}

model Template {
  id        Int       @id @default(autoincrement())
  author    String    @db.VarChar(50)
  thumbnail String
  title     String    @db.VarChar(255)
  images    Image[]
  tags      Tag[]
  slug      String    @unique
  updatedAt DateTime @updatedAt

}

model Image {
  id         Int       @id @default(autoincrement())
  imageUrl   String
  template   Template? @relation(fields: [templateId], references: [id])
  templateId Int

  @@index([templateId])  
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  templates Template[]
}

model keep_alive_table {
  id      String @id
  counter Int    @default(0)
}